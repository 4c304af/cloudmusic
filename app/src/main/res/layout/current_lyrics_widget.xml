<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="18dp"
        android:maxLines="1" android:ellipsize="end" android:text="云听" android:textSize="11sp"
        android:textColor="@color/widget_accent" />
    <TextView android:id="@+id/widget_lyric" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:includeFontPadding="false"
        android:ellipsize="end" android:maxLines="2" android:text="暂无歌词"
        android:textColor="@color/widget_text" android:textSize="17sp" />
    <TextView android:id="@+id/widget_translation" android:layout_width="match_parent" android:layout_height="16dp"
        android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
        android:textColor="@color/widget_secondary" android:textSize="11sp" />
</LinearLayout>
